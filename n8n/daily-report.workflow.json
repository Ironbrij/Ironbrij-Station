{
  "name": "SavyTime - Daily Attendance Report",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 15
            }
          ]
        }
      },
      "id": "daily-report-schedule",
      "name": "Every 15 Minutes",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [0, 0]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "base-url",
              "name": "baseUrl",
              "value": "https://station.savykids.com",
              "type": "string"
            },
            {
              "id": "admin-key",
              "name": "adminKey",
              "value": "REPLACE_WITH_ADMIN_API_KEY",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "daily-report-config",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [220, 0],
      "notes": "The only node to edit. adminKey must match ADMIN_API_KEY in the SavyTime deployment."
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.baseUrl }}/api/daily-report",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "x-admin-key",
              "value": "={{ $json.adminKey }}"
            }
          ]
        },
        "options": {
          "timeout": 300000
        }
      },
      "id": "daily-report-run",
      "name": "Send Any Day That Is Ready",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [440, 0],
      "notes": "One call covers every client that has switched the daily report on. A day goes out once every VA's shift has finished and they have clocked out, and never twice. Most runs send nothing. A failed delivery returns an error, so n8n marks the execution as failed."
    }
  ],
  "connections": {
    "Every 15 Minutes": {
      "main": [[{ "node": "Config", "type": "main", "index": 0 }]]
    },
    "Config": {
      "main": [[{ "node": "Send Any Day That Is Ready", "type": "main", "index": 0 }]]
    }
  },
  "settings": {
    "executionOrder": "v1",
    "timezone": "Australia/Sydney"
  },
  "pinData": {}
}
