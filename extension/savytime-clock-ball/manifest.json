{
  "manifest_version": 3,
  "name": "SavyTime Clock Ball",
  "version": "1.2.0",
  "description": "Your SavyTime shift timer on every website, with SavyTime itself one click away in the side panel.",
  "permissions": ["storage", "scripting", "alarms", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "SavyTime Clock Ball",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "side_panel": { "default_path": "panel.html" },
  "web_accessible_resources": [{ "resources": ["logo.png"], "matches": ["<all_urls>"] }],
  "content_scripts": [
    {
      "matches": ["https://station.savykids.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "ball.js"],
      "run_at": "document_idle"
    }
  ]
}
