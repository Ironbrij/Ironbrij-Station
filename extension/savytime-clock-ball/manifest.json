{
  "manifest_version": 3,
  "name": "SavyTime Clock Ball",
  "version": "1.0.0",
  "description": "A little robot ball that counts your worked time while you're clocked in to SavyTime.",
  "permissions": ["storage"],
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "action": {
    "default_title": "SavyTime Clock Ball",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://station.savykids.com/*"],
      "js": ["bridge.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["shared.js", "ball.js"],
      "run_at": "document_idle"
    }
  ]
}
