rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthed() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthed() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email in ['pabibek9@gmail.com', 'bibekparajuli05@gmail.com', 'louis@ironbrij.com.au'])
      );
    }

    function hasEmployeeProfile() {
      return isAuthed() && exists(/databases/$(database)/documents/employees/$(request.auth.uid));
    }

    function canAccessCompany(companyId) {
      return isAdmin() || (
        hasEmployeeProfile() && (
          (
            'companyIds' in get(/databases/$(database)/documents/employees/$(request.auth.uid)).data &&
            companyId in get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.companyIds
          ) ||
          (
            'companyId' in get(/databases/$(database)/documents/employees/$(request.auth.uid)).data &&
            get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.companyId == companyId
          ) ||
          (
            companyId == 'default' &&
            !('companyId' in get(/databases/$(database)/documents/employees/$(request.auth.uid)).data)
          )
        )
      );
    }

    function ownsEmployee(employeeId) {
      return isAuthed() && (
        employeeId == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/employees/$(employeeId)) &&
          get(/databases/$(database)/documents/employees/$(employeeId)).data.authUid == request.auth.uid
        )
      );
    }

    function sharesEmployeeCompany(employeeData) {
      return hasEmployeeProfile() &&
        'companyIds' in employeeData &&
        'companyIds' in get(/databases/$(database)/documents/employees/$(request.auth.uid)).data &&
        employeeData.companyIds.hasAny(
          get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.companyIds
        );
    }

    // Registered Users Collection
    match /users/{uid} {
      allow read: if isAdmin() || isOwner(empId) ||
        (isAuthed() && 'email' in resource.data && resource.data.email == request.auth.token.email) ||
        sharesEmployeeCompany(resource.data);
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Admins Collection
    match /admins/{uid} {
      allow read: if isAuthed();
      allow write: if isAuthed() && (isOwner(uid) || isAdmin());
    }

    // Employees Collection
    match /employees/{empId} {
      allow read: if isAuthed();
      allow create: if isAdmin() || isOwner(empId);
      allow update: if isAdmin() || (
        isOwner(empId) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'email', 'photoUrl', 'photoURL', 'authUid', 'inviteStatus', 'lastLogin', 'updatedAt'
        ])
      );
      allow delete: if isAdmin();
    }

    // Company & Departments Settings
    match /companies/{id} {
      allow read: if canAccessCompany(id);
      allow write: if isAdmin();
    }
    match /departments/{id} {
      allow read: if isAdmin() ||
        ('companyId' in resource.data && canAccessCompany(resource.data.companyId)) ||
        (!('companyId' in resource.data) && canAccessCompany('default'));
      allow write: if isAdmin();
    }
    match /departments/{id}/members/{memberId} {
      allow read, write: if isAdmin();
    }

    // HR Announcements & Notices Collection
    match /notices/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // Payroll Payouts Records Collection
    match /payouts/{id} {
      allow read, write: if isAdmin();
    }

    // Punches (Clock In / Clock Out / Overtime)
    match /punches/{id} {
      allow read: if isAdmin() || (
        ownsEmployee(resource.data.employeeId) &&
        (!('companyId' in resource.data) || canAccessCompany(resource.data.companyId))
      );
      allow create: if isAdmin() || (
        ownsEmployee(request.resource.data.employeeId) &&
        'companyId' in request.resource.data &&
        canAccessCompany(request.resource.data.companyId)
      );
      allow update, delete: if isAdmin();
    }

    // Leave Requests
    match /leaveRequests/{id} {
      allow read: if isAdmin() || (
        ownsEmployee(resource.data.employeeId) &&
        (!('companyId' in resource.data) || canAccessCompany(resource.data.companyId))
      );
      allow create: if ownsEmployee(request.resource.data.employeeId) &&
        'companyId' in request.resource.data &&
        canAccessCompany(request.resource.data.companyId);
      allow update: if isAdmin() || (
        ownsEmployee(resource.data.employeeId) &&
        request.resource.data.employeeId == resource.data.employeeId &&
        request.resource.data.companyId == resource.data.companyId &&
        request.resource.data.status == 'rejected' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'decidedAt', 'decidedBy', 'decisionReason'
        ])
      );
      allow delete: if isAdmin();
    }

    match /attendanceReminders/{id} {
      allow get: if isAdmin() || (
        isAuthed() && id.matches(request.auth.uid + '__punch-out__.*')
      );
      allow list: if isAdmin() || (
        ownsEmployee(resource.data.employeeId) &&
        canAccessCompany(resource.data.companyId)
      );
      allow create, update: if isAdmin() || (
        ownsEmployee(request.resource.data.employeeId) &&
        canAccessCompany(request.resource.data.companyId)
      );
      allow delete: if isAdmin();
    }

    // SOD & EOD configuration and question bank
    match /reportingSettings/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /reportQuestions/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // Submitted SOD & EOD daily reports
    match /dailyReports/{reportId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.userId == request.auth.uid);
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (
        isAuthed() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // Help Requests & User Feedback
    match /helpRequests/{id} {
      allow read, write: if true;
    }

    match /feedback/{id} {
      allow read, write: if true;
    }

    // Personal automation status
    match /automationProfiles/{token} {
      allow read: if true;
      allow create, update, delete: if isAuthed();
    }

    // Invites (Account activation)
    match /invites/{token} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }
  }
}
