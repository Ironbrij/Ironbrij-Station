rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthed() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthed() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email in ['pabibek9@gmail.com', 'bibekparajuli05@gmail.com', 'louis@ironbrij.com.au'])
      );
    }

    // Registered Users Collection
    match /users/{uid} {
      allow read: if isAuthed();
      allow write: if isAuthed() && (isOwner(uid) || isAdmin());
    }

    // Admins Collection
    match /admins/{uid} {
      allow read: if isAuthed();
      allow write: if isAuthed() && (isOwner(uid) || isAdmin());
    }

    // Employees Collection (Contains department ID, hourly rates, shift times, country, timezone)
    match /employees/{empId} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update: if isAdmin() || (
        isAuthed() &&
        request.resource.data.get('reportingRequirement', 'none') ==
          resource.data.get('reportingRequirement', 'none')
      );
      allow delete: if isAdmin();
    }

    // Company & Departments Settings
    match /companies/{id} {
      allow read, write: if isAuthed();
    }
    match /departments/{id} {
      allow read, write: if isAuthed();
    }
    match /departments/{id}/members/{memberId} {
      allow read, write: if isAuthed();
    }

    // HR Announcements & Notices Collection
    match /notices/{id} {
      allow read, write: if isAuthed();
    }

    // Payroll Payouts Records Collection
    match /payouts/{id} {
      allow read, write: if isAuthed();
    }

    // Punches (Clock In / Clock Out / Overtime)
    match /punches/{id} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update, delete: if isAdmin();
    }

    // Leave Requests
    match /leaveRequests/{id} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update, delete: if isAdmin();
    }

    // SOD & EOD configuration and question bank
    match /reportingSettings/{id} {
      allow read: if isAuthed();
      allow create, update, delete: if isAdmin();
    }

    match /reportQuestions/{id} {
      allow read: if isAuthed();
      allow create, update, delete: if isAdmin();
    }

    // Submitted reports are immutable historical records.
    match /dailyReports/{reportId} {
      // Admins can list/read all reports; employees can only read their own.
      allow list: if isAdmin() || (
        isAuthed() && resource.data.userId == request.auth.uid
      );
      allow get: if isAdmin() || (
        isAuthed() && resource.data.userId == request.auth.uid
      );
      allow create: if isAuthed()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.reportType in ['sod', 'eod']
        && request.resource.data.submittedAt == request.time
        && reportId == request.auth.uid + '_' + request.resource.data.reportDate + '_' + request.resource.data.reportType;
      allow update, delete: if false;
    }

    // Personal automation status.
    // The random document ID is the private API token.
    match /automationProfiles/{token} {
      allow read: if true;
      allow create, update, delete: if isAuthed();
    }

    // Invites (Account activation)
    match /invites/{token} {
      allow read, create, update: if true;
      allow delete: if isAdmin();
    }
  }
}
