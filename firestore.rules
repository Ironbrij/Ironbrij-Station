rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthed() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isAuthed() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isAuthed() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email in ['pabibek9@gmail.com', 'bibekparajuli05@gmail.com', 'louis@ironbrij.com.au'])
      );
    }

    function hasEmployeeProfile() {
      return isAuthed() && exists(/databases/$(database)/documents/employees/$(request.auth.uid));
    }

    function canAccessCompany(companyId) {
      return isAdmin() || (
        hasEmployeeProfile() && (
          (
            'companyIds' in get(/databases/$(database)/documents/employees/$(request.auth.uid)).data &&
            companyId in get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.companyIds
          ) ||
          (
            'companyId' in get(/databases/$(database)/documents/employees/$(request.auth.uid)).data &&
            get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.companyId == companyId
          ) ||
          (
            companyId == 'default' &&
            !('companyId' in get(/databases/$(database)/documents/employees/$(request.auth.uid)).data)
          )
        )
      );
    }

    function ownsEmployee(employeeId) {
      return isAuthed() && (
        employeeId == request.auth.uid ||
        (
          exists(/databases/$(database)/documents/employees/$(employeeId)) &&
          (
            get(/databases/$(database)/documents/employees/$(employeeId)).data.authUid == request.auth.uid ||
            (
              request.auth.token.email != null &&
              'email' in get(/databases/$(database)/documents/employees/$(employeeId)).data &&
              get(/databases/$(database)/documents/employees/$(employeeId)).data.email == request.auth.token.email
            )
          )
        )
      );
    }

    function sharesEmployeeCompany(employeeData) {
      return hasEmployeeProfile() &&
        'companyIds' in employeeData &&
        'companyIds' in get(/databases/$(database)/documents/employees/$(request.auth.uid)).data &&
        employeeData.companyIds.hasAny(
          get(/databases/$(database)/documents/employees/$(request.auth.uid)).data.companyIds
        );
    }

    // Registered Users Collection
    match /users/{uid} {
      allow read: if isAdmin() || isOwner(uid) ||
        (isAuthed() && 'email' in resource.data && resource.data.email == request.auth.token.email) ||
        sharesEmployeeCompany(resource.data);
      allow create, update: if isOwner(uid) || isAdmin();
      allow delete: if isAdmin();
    }

    // Admins Collection
    // Only an admin may make or remove an admin. Anyone signed in used to be
    // able to write their own record here, which made them an admin.
    match /admins/{uid} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // Employees Collection
    // Only admins create or change employee records. Signing in only links a
    // person's own record to their login: they may set their login id, email,
    // photo and accepted invite on it, and only while no other login owns it.
    match /employees/{empId} {
      allow read: if isAuthed();
      allow create: if isAdmin();
      allow update: if isAdmin() || linksOwnEmployee(empId);
      allow delete: if isAdmin();
    }

    function linksOwnEmployee(empId) {
      return ownsEmployee(empId) &&
        resource.data.get('authUid', '') in ['', request.auth.uid] &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['authUid', 'email', 'inviteStatus', 'photoUrl']) &&
        request.resource.data.get('authUid', request.auth.uid) == request.auth.uid &&
        request.resource.data.get('inviteStatus', 'accepted') == 'accepted' &&
        request.resource.data.get('email', '').lower() == request.auth.token.email.lower();
    }

    // Company & Departments Settings
    match /companies/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }
    match /departments/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }
    match /departments/{id}/members/{memberId} {
      allow read, write: if isAdmin();
    }

    // HR Announcements & Notices Collection
    match /notices/{id} {
      allow read: if isAuthed();
      allow create: if isAuthed();
      allow update, delete: if isAdmin();
    }

    // Payroll Payouts Records Collection
    match /payouts/{id} {
      allow read, write: if isAdmin();
    }

    // Punches (Clock In / Clock Out / Overtime)
    match /punches/{id} {
      allow read: if isAuthed();
      allow create, update: if isAdmin() || (isAuthed() && ownsEmployee(request.resource.data.employeeId));
      allow delete: if isAdmin();
    }

    // Leave Requests
    // Only an admin approves leave. Employees file requests as pending and may
    // cancel their own (pending -> rejected, or approved -> rejected), nothing else.
    match /leaveRequests/{id} {
      allow read: if isAuthed();
      allow create: if isAdmin() || (
        ownsEmployee(request.resource.data.employeeId) &&
        request.resource.data.status == 'pending'
      );
      allow update: if isAdmin() || (
        ownsEmployee(resource.data.employeeId) &&
        request.resource.data.employeeId == resource.data.employeeId &&
        (
          request.resource.data.status == 'rejected' ||
          (resource.data.status == 'pending' && request.resource.data.status == 'pending')
        )
      );
      allow delete: if isAdmin();
    }

    // Overtime Requests
    match /overtimeRequests/{id} {
      allow read: if isAuthed();
      allow create, update: if isAdmin() || (isAuthed() && ownsEmployee(request.resource.data.employeeId));
      allow delete: if isAdmin();
    }

    match /attendanceReminders/{id} {
      allow read, write: if isAuthed();
    }

    // Every report that was sent, kept as it was sent. Admins read it; sending
    // adds to it, as the admin or the weekly automation's admin login. A record
    // is never changed.
    match /reportHistory/{id} {
      allow read, create, delete: if isAdmin();
      allow update: if false;
    }

    // Edits an admin makes on the Reports page, one document per company and period.
    match /reportEdits/{id} {
      allow read, write: if isAdmin();
    }

    // SOD & EOD configuration and question bank
    match /reportingSettings/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    match /reportQuestions/{id} {
      allow read: if isAuthed();
      allow write: if isAdmin();
    }

    // Submitted SOD & EOD daily reports
    match /dailyReports/{reportId} {
      allow read: if isAdmin() || (isAuthed() && resource.data.userId == request.auth.uid);
      allow create: if isAuthed() && request.resource.data.userId == request.auth.uid;
      allow update: if isAdmin() || (
        isAuthed() &&
        resource.data.userId == request.auth.uid &&
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if isAdmin();
    }

    // Help Requests & User Feedback
    match /helpRequests/{id} {
      allow read, write: if isAuthed();
    }

    match /feedback/{id} {
      allow read, write: if isAuthed();
    }

    // Personal automation status
    match /automationProfiles/{token} {
      allow read: if isAuthed();
      allow create, update, delete: if isAuthed();
    }

    // Invites (Account activation)
    // An invite link is opened before signing in, so one invite can be read by
    // its token. Only admins make or list invites; the invited person may only
    // mark their own invite used.
    match /invites/{token} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (
        isAuthed() &&
        request.auth.token.email != null &&
        resource.data.email.lower() == request.auth.token.email.lower() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['used']) &&
        request.resource.data.used == true
      );
    }

    // A client's Work on Holiday / Do Not Work answer. The holiday email links
    // to one by its random token, and the client answers without signing in,
    // so it can be read by token and answered once. Only admins make or list them.
    match /holidayResponses/{token} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (
        resource.data.decision == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['decision', 'decidedAt']) &&
        request.resource.data.decision in ['work', 'off'] &&
        request.resource.data.decidedAt is string
      );
    }

    // A client's daylight saving choice: follow their new DST schedule, or keep
    // the VA's current hours. Like a holiday answer, read by its random token and
    // answered once without signing in. Only admins make or list them.
    match /dstResponses/{token} {
      allow get: if true;
      allow list, create, delete: if isAdmin();
      allow update: if isAdmin() || (
        resource.data.decision == null &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['decision', 'decidedAt']) &&
        request.resource.data.decision in ['follow', 'keep'] &&
        request.resource.data.decidedAt is string
      );
    }

    // Admin API Tokens
    match /adminApiTokens/{token} {
      allow read: if isAdmin();
      allow write: if false; // Only manageable directly via Firebase Console
    }
  }
}
